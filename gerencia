<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerencia Antonia Santos - Sistema de Permisos</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col">

    <!-- Header institucional -->
    <header class="bg-indigo-900 text-white shadow-md">
        <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <div class="bg-amber-500 text-indigo-950 p-3 rounded-xl font-black text-xl shadow">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-wide">I.E. ANTONIA SANTOS</h1>
                    <p class="text-xs text-amber-300 font-medium">Gestión Directiva y Control de Permisos - Montería</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="switchView('solicitud')" id="nav-solicitud" class="px-4 py-2 bg-indigo-800 hover:bg-indigo-700 text-sm font-semibold rounded-lg transition border border-indigo-700 shadow-sm flex items-center gap-2">
                    <i class="fa-solid fa-file-pen"></i> Nueva Solicitud
                </button>
                <button onclick="checkAdminAccess()" id="nav-admin" class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-indigo-950 text-sm font-bold rounded-lg transition shadow-md flex items-center gap-2">
                    <i class="fa-solid fa-lock"></i> Acceso Directivos
                </button>
            </div>
        </div>
    </header>

    <!-- Contenido Principal -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 py-6">

        <!-- VISTA 1: FORMULARIO DE SOLICITUD -->
        <section id="view-solicitud" class="space-y-6">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8">
                <div class="border-b border-slate-100 pb-4 mb-6">
                    <h2 class="text-xl font-bold text-indigo-900 flex items-center gap-2">
                        <i class="fa-solid fa-clipboard-user text-amber-500"></i> Solicitud de Permiso Laboral
                    </h2>
                    <p class="text-sm text-slate-500 mt-1">Complete los datos de la ausencia, cargue los soportes correspondientes y seleccione la jornada en el calendario visual.</p>
                </div>

                <form id="permissionForm" onsubmit="handleFormSubmit(event)" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Nombre del Solicitante -->
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-1">Nombre Completo del Solicitante</label>
                            <input type="text" id="sol_nombre" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="Ej. Ana Milena Gómez">
                        </div>

                        <!-- Cargo -->
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-1">Cargo</label>
                            <select id="sol_cargo" onchange="updateAreaOptions()" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-white">
                                <option value="">Seleccione su cargo...</option>
                                <option value="Docente Preescolar">Docente Preescolar</option>
                                <option value="Docente Primaria">Docente Básica Primaria</option>
                                <option value="Docente Secundaria">Docente Básica Secundaria / Media</option>
                                <option value="Administrativo">Personal Administrativo</option>
                            </select>
                        </div>

                        <!-- Área o Grado / Asignatura (Dinámico) -->
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-1">Nivel / Grado / Área / Asignatura</label>
                            <select id="sol_area" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-white">
                                <option value="">Primero seleccione un cargo...</option>
                            </select>
                        </div>

                        <!-- Jornada -->
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-1">Jornada Solicitada</label>
                            <select id="sol_jornada" onchange="updateDayAvailability()" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-white">
                                <option value="">Seleccione jornada...</option>
                                <option value="Mañana">Mañana (6:15 a.m. - 1:15 p.m.)</option>
                                <option value="Tarde">Tarde (12:30 p.m. - 5:45 p.m.)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Selector de Fecha / Calendario Visual -->
                    <div class="bg-indigo-50/50 rounded-xl p-4 border border-indigo-100">
                        <label class="block text-sm font-bold text-indigo-950 mb-2 flex items-center gap-2">
                            <i class="fa-solid fa-calendar-days text-indigo-600"></i> Fecha del Permiso (Selección Visual)
                        </label>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-center">
                            <input type="date" id="sol_fecha" onchange="updateDayAvailability()" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                            <div id="slot-indicator" class="text-sm font-semibold p-3 rounded-xl bg-white border border-indigo-200 text-indigo-900 flex items-center justify-between shadow-xs">
                                <span>Cupos disponibles:</span>
                                <span id="slot-count-badge" class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold">Seleccione fecha y jornada</span>
                            </div>
                        </div>
                    </div>

                    <!-- Motivo -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Motivo del Permiso</label>
                        <textarea id="sol_motivo" rows="2" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="Describa brevemente la razón de su solicitud..."></textarea>
                    </div>

                    <!-- Carga de Archivos (Doble Soporte) -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2 border-t border-slate-100">
                        <!-- Soporte del Permiso -->
                        <div class="p-4 rounded-xl border-2 border-dashed border-slate-300 hover:border-indigo-500 transition bg-slate-50">
                            <label class="block text-sm font-bold text-slate-800 mb-1">
                                <i class="fa-solid fa-file-pdf text-red-500 mr-1"></i> 1. Soporte del Permiso (Cita, calamidad, etc.)
                            </label>
                            <p class="text-xs text-slate-500 mb-3">Adjunte PDF o imagen del documento justificativo.</p>
                            <input type="file" id="file_permiso" accept=".pdf,.png,.jpg,.jpeg" required class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-indigo-100 file:text-indigo-700 hover:file:bg-indigo-200 cursor-pointer">
                        </div>

                        <!-- Soporte de Actividades -->
                        <div class="p-4 rounded-xl border-2 border-dashed border-slate-300 hover:border-indigo-500 transition bg-slate-50">
                            <label class="block text-sm font-bold text-slate-800 mb-1">
                                <i class="fa-solid fa-file-lines text-amber-600 mr-1"></i> 2. Soporte de Actividades a Realizar
                            </label>
                            <p class="text-xs text-slate-500 mb-3">Adjunte guía, taller o plan para los estudiantes durante su ausencia.</p>
                            <input type="file" id="file_actividades" accept=".pdf,.png,.jpg,.jpeg,.docx" required class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-amber-100 file:text-amber-800 hover:file:bg-amber-200 cursor-pointer">
                        </div>
                    </div>

                    <!-- Botón Enviar -->
                    <div class="pt-4 flex justify-end">
                        <button type="submit" id="btn-submit" class="w-full md:w-auto px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-lg transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-paper-plane"></i> Enviar Solicitud de Permiso
                        </button>
                    </div>
                </form>
            </div>
        </section>

        <!-- VISTA 2: PANEL DE DIRECTIVOS -->
        <section id="view-admin" class="hidden space-y-6">
            <!-- Barra de Control de Sesión Directiva -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex flex-col md:flex-row justify-between items-center gap-4">
                <div class="flex items-center gap-3">
                    <div class="bg-indigo-100 text-indigo-700 p-3 rounded-xl text-xl">
                        <i class="fa-solid fa-user-shield"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-indigo-950" id="admin-welcome-title">Panel de Control Directivo</h3>
                        <p class="text-xs text-slate-500" id="admin-role-subtitle">Sesión activa</p>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <button onclick="loadSampleData()" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-lg transition">
                        <i class="fa-solid fa-rotate"></i> Cargar Datos de Prueba
                    </button>
                    <button onclick="logoutAdmin()" class="px-4 py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 text-sm font-semibold rounded-lg transition border border-rose-200 flex items-center gap-2">
                        <i class="fa-solid fa-right-from-bracket"></i> Salir
                    </button>
                </div>
            </div>

            <!-- Filtros y Exportación de Reportes -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 space-y-4">
                <h4 class="text-sm font-bold text-slate-700 uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-filter text-indigo-600"></i> Filtrar Solicitudes y Generar Reportes
                </h4>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Fecha Específica</label>
                        <input type="date" id="filter-date" onchange="renderAdminTable()" class="w-full px-3 py-2 text-sm rounded-xl border border-slate-300 bg-white">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Jornada</label>
                        <select id="filter-jornada" onchange="renderAdminTable()" class="w-full px-3 py-2 text-sm rounded-xl border border-slate-300 bg-white">
                            <option value="">Todas las jornadas</option>
                            <option value="Mañana">Mañana</option>
                            <option value="Tarde">Tarde</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Buscar por Solicitante</label>
                        <input type="text" id="filter-name" oninput="renderAdminTable()" placeholder="Nombre o cargo..." class="w-full px-3 py-2 text-sm rounded-xl border border-slate-300">
                    </div>
                    <div class="flex items-end">
                        <button onclick="exportToCSV()" class="w-full py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold rounded-xl shadow-sm transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-file-excel"></i> Exportar Reporte
                        </button>
                    </div>
                </div>
            </div>

            <!-- Tabla de Solicitudes -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="p-6 border-b border-slate-100 flex justify-between items-center">
                    <h4 class="font-bold text-slate-800">Listado de Permisos Registrados</h4>
                    <span id="total-records" class="text-xs font-semibold bg-indigo-50 text-indigo-700 px-3 py-1 rounded-full">0 solicitudes</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="bg-slate-100 text-slate-700 font-bold text-xs uppercase tracking-wider">
                                <th class="p-4">Solicitante</th>
                                <th class="p-4">Área / Cargo</th>
                                <th class="p-4">Fecha y Jornada</th>
                                <th class="p-4">Motivo</th>
                                <th class="p-4">Soportes</th>
                                <th class="p-4">Estado</th>
                                <th class="p-4 text-center">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="admin-table-body" class="divide-y divide-slate-100">
                            <!-- Inyectado por JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

    <!-- Modal de Inicio de Sesión Directiva -->
    <div id="loginModal" class="fixed inset-0 bg-indigo-950/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full p-8 space-y-6 relative border border-slate-100">
            <button onclick="closeLoginModal()" class="absolute top-6 right-6 text-slate-400 hover:text-slate-700">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
            <div class="text-center space-y-2">
                <div class="w-14 h-14 bg-amber-500 text-indigo-950 rounded-2xl mx-auto flex items-center justify-center text-2xl font-bold shadow-md">
                    <i class="fa-solid fa-key"></i>
                </div>
                <h3 class="text-xl font-bold text-indigo-950">Acceso Directivos</h3>
                <p class="text-xs text-slate-500">Ingrese sus credenciales institucionales autorizadas.</p>
            </div>
            <form onsubmit="handleAdminLogin(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Usuario</label>
                    <input type="text" id="login-user" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="Ej. rector">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Contraseña</label>
                    <input type="password" id="login-pass" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="••••••••••••">
                </div>
                <button type="submit" class="w-full py-3 bg-indigo-900 hover:bg-indigo-800 text-white font-bold rounded-xl shadow-md transition text-sm">
                    Ingresar al Panel
                </button>
            </form>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-600 space-y-1">
                <p class="font-bold text-indigo-950">Credenciales de prueba:</p>
                <p>• Rector (ALGC): <code class="bg-white px-1 py-0.5 rounded border border-slate-200">rector</code> / <code class="bg-white px-1 py-0.5 rounded border border-slate-200">RectorAntonia2026*</code></p>
                <p>• Coord. Mañana: <code class="bg-white px-1 py-0.5 rounded border border-slate-200">coord.manana</code> / <code class="bg-white px-1 py-0.5 rounded border border-slate-200">MananaAntonia2026*</code></p>
                <p>• Coord. Tarde: <code class="bg-white px-1 py-0.5 rounded border border-slate-200">coord.tarde</code> / <code class="bg-white px-1 py-0.5 rounded border border-slate-200">TardeAntonia2026*</code></p>
            </div>
        </div>
    </div>

    <!-- Script de Funcionalidad -->
    <script>
        let permissions = JSON.parse(localStorage.getItem('antonia_santos_perms')) || [];
        let currentAdmin = null;

        const areaOptionsMap = {
            "Docente Preescolar": ["Preescolar - Transición A", "Preescolar - Transición B", "Preescolar - Jardín"],
            "Docente Primaria": ["1° de Primaria", "2° de Primaria", "3° de Primaria", "4° de Primaria", "5° de Primaria"],
            "Docente Secundaria": ["Matemáticas", "Lengua Castellana", "Ciencias Naturales", "Ciencias Sociales", "Inglés", "Educación Física", "Informática", "Ética y Valores", "Artística"],
            "Administrativo": ["Secretaría Académica", "Pagaduría / Financiera", "Biblioteca", "Coordinación de Disciplina", "Servicios Generales"]
        };

        function updateAreaOptions() {
            const cargo = document.getElementById('sol_cargo').value;
            const areaSelect = document.getElementById('sol_area');
            areaSelect.innerHTML = '<option value="">Seleccione área o nivel...</option>';
            
            if (areaOptionsMap[cargo]) {
                areaOptionsMap[cargo].forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = item;
                    opt.textContent = item;
                    areaSelect.appendChild(opt);
                });
            }
        }

        function updateDayAvailability() {
            const fecha = document.getElementById('sol_fecha').value;
            const jornada = document.getElementById('sol_jornada').value;
            const badge = document.getElementById('slot-count-badge');

            if (!fecha || !jornada) {
                badge.className = "px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-bold";
                badge.textContent = "Seleccione fecha y jornada";
                return;
            }

            const count = permissions.filter(p => p.fecha === fecha && p.jornada === jornada && p.estado !== 'Rechazado').length;
            const disponibles = 2 - count;

            if (disponibles > 0) {
                badge.className = "px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold";
                badge.textContent = `${disponibles} cupo(s) disponible(s)`;
            } else {
                badge.className = "px-2.5 py-1 rounded-full bg-rose-100 text-rose-800 text-xs font-bold";
                badge.textContent = "¡Jornada llena (Máx. 2 permisos)!";
            }
        }

        function handleFormSubmit(e) {
            e.preventDefault();
            const fecha = document.getElementById('sol_fecha').value;
            const jornada = document.getElementById('sol_jornada').value;

            const count = permissions.filter(p => p.fecha === fecha && p.jornada === jornada && p.estado !== 'Rechazado').length;
            if (count >= 2) {
                alert("Lo sentimos, ya se ha alcanzado el límite máximo de 2 permisos aprobados/solicitados para esta jornada.");
                return;
            }

            const newPermit = {
                id: Date.now(),
                nombre: document.getElementById('sol_nombre').value,
                cargo: document.getElementById('sol_cargo').value,
                area: document.getElementById('sol_area').value,
                jornada: jornada,
                fecha: fecha,
                motivo: document.getElementById('sol_motivo').value,
                soportePermiso: document.getElementById('file_permiso').files[0]?.name || "archivo_soporte.pdf",
                soporteActividades: document.getElementById('file_actividades').files[0]?.name || "actividades_ausencia.pdf",
                estado: "Pendiente",
                fechaRegistro: new Date().toLocaleDateString()
            };

            permissions.push(newPermit);
            localStorage.setItem('antonia_santos_perms', JSON.stringify(permissions));

            alert("¡Solicitud enviada con éxito! Su permiso ha sido registrado para revisión directiva.");
            document.getElementById('permissionForm').reset();
            document.getElementById('slot-count-badge').textContent = "Seleccione fecha y jornada";
        }

        function switchView(view) {
            if (view === 'solicitud') {
                document.getElementById('view-solicitud').classList.remove('hidden');
                document.getElementById('view-admin').classList.add('hidden');
            } else {
                document.getElementById('view-solicitud').classList.add('hidden');
                document.getElementById('view-admin').classList.remove('hidden');
                renderAdminTable();
            }
        }

        function checkAdminAccess() {
            if (!currentAdmin) {
                document.getElementById('loginModal').classList.remove('hidden');
            } else {
                switchView('admin');
            }
        }

        function closeLoginModal() {
            document.getElementById('loginModal').classList.add('hidden');
        }

        function handleAdminLogin(e) {
            e.preventDefault();
            const user = document.getElementById('login-user').value.trim();
            const pass = document.getElementById('login-pass').value.trim();

            const admins = {
                "rector": { pass: "RectorAntonia2026*", name: "Alvaro Gonzalez Contreras (ALGC)", role: "Rector (Control Total)", jornada: "Todas" },
                "coord.manana": { pass: "MananaAntonia2026*", name: "Coordinación Jornada Mañana", role: "Coordinador", jornada: "Mañana" },
                "coord.tarde": { pass: "TardeAntonia2026*", name: "Coordinación Jornada Tarde", role: "Coordinador", jornada: "Tarde" }
            };

            if (admins[user] && admins[user].pass === pass) {
                currentAdmin = admins[user];
                closeLoginModal();
                document.getElementById('admin-welcome-title').textContent = `Bienvenido, ${currentAdmin.name}`;
                document.getElementById('admin-role-subtitle').textContent = `Rol: ${currentAdmin.role}`;
                switchView('admin');
            } else {
                alert("Usuario o contraseña incorrectos.");
            }
        }

        function logoutAdmin() {
            currentAdmin = null;
            switchView('solicitud');
        }

        function renderAdminTable() {
            const tbody = document.getElementById('admin-table-body');
            tbody.innerHTML = '';

            const filterDate = document.getElementById('filter-date').value;
            const filterJornada = document.getElementById('filter-jornada').value;
            const filterName = document.getElementById('filter-name').value.toLowerCase();

            let filtered = permissions.filter(p => {
                if (currentAdmin && currentAdmin.jornada !== "Todas" && p.jornada !== currentAdmin.jornada) {
                    return false;
                }
                if (filterDate && p.fecha !== filterDate) return false;
                if (filterJornada && p.jornada !== filterJornada) return false;
                if (filterName && !p.nombre.toLowerCase().includes(filterName) && !p.cargo.toLowerCase().includes(filterName)) return false;
                return true;
            });

            document.getElementById('total-records').textContent = `${filtered.length} solicitud(es)`;

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="p-8 text-center text-slate-400">No se encontraron solicitudes registradas.</td></tr>`;
                return;
            }

            filtered.forEach(p => {
                let badgeColor = p.estado === 'Aprobado' ? 'bg-emerald-100 text-emerald-800' : p.estado === 'Rechazado' ? 'bg-rose-100 text-rose-800' : 'bg-amber-100 text-amber-800';
                
                let tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition";
                tr.innerHTML = `
                    <td class="p-4 font-semibold text-slate-900">${p.nombre}</td>
                    <td class="p-4 text-slate-600">${p.cargo}<br><span class="text-xs text-slate-400">${p.area}</span></td>
                    <td class="p-4 text-slate-600">${p.fecha}<br><span class="text-xs font-bold text-indigo-700">${p.jornada}</span></td>
                    <td class="p-4 text-slate-600 text-xs max-w-xs truncate">${p.motivo}</td>
                    <td class="p-4 space-y-1">
                        <a href="#" onclick="alert('Visualizando soporte de permiso: ${p.soportePermiso}')" class="text-xs text-indigo-600 hover:underline block"><i class="fa-solid fa-file-pdf"></i> ${p.soportePermiso}</a>
                        <a href="#" onclick="alert('Visualizando actividades de ausencia: ${p.soporteActividades}')" class="text-xs text-amber-700 hover:underline block"><i class="fa-solid fa-file-lines"></i> ${p.soporteActividades}</a>
                    </td>
                    <td class="p-4"><span class="px-2.5 py-1 rounded-full text-xs font-bold ${badgeColor}">${p.estado}</span></td>
                    <td class="p-4 text-center space-x-2">
                        <button onclick="updateStatus(${p.id}, 'Aprobado')" title="Aprobar" class="p-1.5 bg-emerald-50 text-emerald-700 rounded-lg hover:bg-emerald-100"><i class="fa-solid fa-check"></i></button>
                        <button onclick="updateStatus(${p.id}, 'Rechazado')" title="Rechazar" class="p-1.5 bg-rose-50 text-rose-700 rounded-lg hover:bg-rose-100"><i class="fa-solid fa-xmark"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function updateStatus(id, newStatus) {
            const p = permissions.find(item => item.id === id);
            if (p) {
                p.estado = newStatus;
                localStorage.setItem('antonia_santos_perms', JSON.stringify(permissions));
                renderAdminTable();
            }
        }

        function loadSampleData() {
            permissions = [
                { id: 1, nombre: "Carmen Rosa Pérez", cargo: "Docente Primaria", area: "3° de Primaria", jornada: "Mañana", fecha: "2026-06-10", motivo: "Cita médica especializada", soportePermiso: "cita_medica.pdf", soporteActividades: "taller_matematicas_3.pdf", estado: "Pendiente", fechaRegistro: "2026-06-01" },
                { id: 2, nombre: "Luis Fernando Gómez", cargo: "Docente Secundaria", area: "Matemáticas", jornada: "Tarde", fecha: "2026-06-11", motivo: "Calamidad familiar", soportePermiso: "calamidad.pdf", soporteActividades: "guia_algebra.pdf", estado: "Aprobado", fechaRegistro: "2026-06-01" }
            ];
            localStorage.setItem('antonia_santos_perms', JSON.stringify(permissions));
            renderAdminTable();
            alert("Datos de prueba cargados con éxito.");
        }

        function exportToCSV() {
            let csv = "Solicitante,Cargo,Area,Jornada,Fecha,Motivo,Estado\n";
            permissions.forEach(p => {
                csv += `"${p.nombre}","${p.cargo}","${p.area}","${p.jornada}","${p.fecha}","${p.motivo}","${p.estado}"\n`;
            });
            let blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            let link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.download = "Reporte_Permisos_AntoniaSantos.csv";
            link.click();
        }
    </script>
